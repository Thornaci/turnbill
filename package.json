{
  "name": "tokenscope",
  "version": "0.1.0",
  "description": "Local cost explorer for Claude Code sessions: project → session → prompt → API call, with estimated spend at current list prices.",
  "type": "module",
  "private": true,
  "bin": {
    "tokenscope": "bin/tokenscope.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr server/index.ts --outDir dist-server",
    "start": "node bin/tokenscope.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "calibrate": "tsx scripts/calibrate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
