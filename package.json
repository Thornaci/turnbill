{
  "name": "turnbill",
  "version": "0.1.0",
  "description": "Local cost explorer for Claude Code sessions: project → session → prompt → API call, with estimated spend at current list prices.",
  "type": "module",
  "license": "MIT",
  "author": "Burak Tayfun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thornaci/turnbill.git"
  },
  "homepage": "https://github.com/Thornaci/turnbill#readme",
  "bugs": {
    "url": "https://github.com/Thornaci/turnbill/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "llm",
    "cost",
    "tokens",
    "prompt-caching",
    "dashboard"
  ],
  "bin": {
    "turnbill": "bin/turnbill.js"
  },
  "files": [
    "bin",
    "dist",
    "dist-server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr server/index.ts --outDir dist-server",
    "start": "node bin/turnbill.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "calibrate": "tsx scripts/calibrate.ts",
    "demo": "npm run build && tsx scripts/demo-data.ts .demo/projects && node bin/turnbill.js --dir .demo/projects",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
